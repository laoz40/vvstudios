{
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist", "build", "coverage", "convex/_generated"],
	"compilerOptions": {
		"target": "ES2023",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"#/*": ["./src/*"],
			"#convex/*": ["./convex/*"],
			"#studio/*": ["./src/sites/studio/*"],
			"@/*": ["./src/*"]
		},
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"noUncheckedSideEffectImports": true
	}
}
